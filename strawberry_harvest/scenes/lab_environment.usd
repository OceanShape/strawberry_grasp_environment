#usda 1.0
(
    "정적 실험실 환경 조립본 (테이블 + 화이트보드 + 바닥) — main_scene에서 payload로 로드됨"
    defaultPrim = "lab_environment"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lab_environment"
{
    def "table" (
        prepend references = @../assets/props/table.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "whiteboard" (
        prepend references = @../assets/props/whiteboard.usd@
    )
    {
        quatd xformOp:orient = (0.7068644733530209, -0.7068644733530208, 0.018509897659264377, -0.01850989765926437)
        double3 xformOp:scale = (1.09, 0.79, 1)
        double3 xformOp:translate = (0.05, 0.81, 0.66)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # [T4c 2026-09-15] 바닥 — 시뮬 전용 소품. 트레이 밖에서 릴리스된 과실이 떨어져 닿는 면.
    # 보드 앞 릴리스 지점(y≈0.74m)은 테이블 상판(y≤0.30m) 밖이라 이 면이 없으면 과실이
    # 끝없이 떨어진다. 실기 바닥 높이 자료는 없다: 작업대 높이 0.75m 가정(상판 z=0 기준).
    # 콜라이더는 layers/physics_layer.usd 의 over 로 붙는다 (table 과 같은 규칙).
    # 두께 1m (윗면 -0.75, 아랫면 -1.75): 런 13(09-15)에서 1.4m 자유 낙하(착지 5.3m/s = 스텝당 88mm)한
    # 과실 하나가 20mm 판을 관통해 사라졌다. 스텝 이동량보다 훨씬 두꺼워야 관통해도 위로 밀려난다.
    # (physics_layer.usd 의 physxScene:enableCCD 와 낙하 과실의 CCD 플래그가 2중 방어.)
    def Cube "floor"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.20, 0.21, 0.23)]
        double3 xformOp:scale = (6, 6, 1.0)
        double3 xformOp:translate = (0.4, 0.3, -1.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
