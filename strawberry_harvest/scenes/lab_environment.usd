#usda 1.0
(
    "정적 실험실 환경 조립본 (테이블 + 화이트보드 + 바닥) — main_scene에서 payload로 로드됨"
    defaultPrim = "lab_environment"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lab_environment"
{
    def "table" (
        prepend references = @../assets/props/table.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "whiteboard" (
        prepend references = @../assets/props/whiteboard.usd@
    )
    {
        quatd xformOp:orient = (0.7068644733530209, -0.7068644733530208, 0.018509897659264377, -0.01850989765926437)
        double3 xformOp:scale = (1.09, 0.79, 1)
        double3 xformOp:translate = (0.05, 0.81, 0.66)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # [T4c 2026-09-15] 바닥 — 시뮬 전용 소품. 트레이 밖에서 릴리스된 과실이 떨어져 닿는 면.
    # 보드 앞 릴리스 지점(y≈0.74m)은 테이블 상판(y≤0.30m) 밖이라 이 면이 없으면 과실이
    # 끝없이 떨어진다. 콜라이더는 layers/physics_layer.usd 의 over 로 붙는다 (table 과 같은 규칙).
    #
    # 높이 (2026-09-16 변경, 윗면 -0.75 -> -0.45): **녹화 프레임에 맞춘 값이다.**
    #   종전 -0.75 는 "작업대 높이 0.75m" 가정이었는데(실기 바닥 높이 자료는 없다), 떨어진 과실이
    #   롱샷 카메라 화면의 y 87~100% 에 놓여 아래 가장자리에서 잘렸다 — 낙하가 실패의 증거인데
    #   화면에서 사라지면 증거가 안 된다. -0.45 에서 화면 y 77~90% 로 들어온다
    #   (scene_tools/check_camera_framing.py 의 투영과 같은 계산). 이제 이 높이는 실기 작업대
    #   높이의 추정이 아니라 **시뮬 촬영용으로 고른 값**이다. 낙하 거리 1.40m -> 1.10m.
    #   isaac_sim_script_editor_bridge.FLOOR_TOP_M 이 같은 값이어야 DROP_REST 로그가 맞는다.
    # 두께 1m (윗면 -0.45, 아랫면 -1.45): 런 13(09-15)에서 1.4m 자유 낙하(착지 5.3m/s = 스텝당 88mm)한
    # 과실 하나가 20mm 판을 관통해 사라졌다. 스텝 이동량보다 훨씬 두꺼워야 관통해도 위로 밀려난다.
    # (physics_layer.usd 의 physxScene:enableCCD 와 낙하 과실의 CCD 플래그가 2중 방어.)
    def Cube "floor"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.20, 0.21, 0.23)]
        double3 xformOp:scale = (6, 6, 1.0)
        double3 xformOp:translate = (0.4, 0.3, -0.95)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # [2026-09-19] 테이블 다리 — 시뮬 전용 소품, **보이기만 한다**. 상판이 공중에 떠 보이지 않게 넣었다 (사용자 지정 치수).
    #   단면 30 x 30mm (09-19 50mm 에서 줄임 — 롱샷에서 두꺼워 보였다), 길이 415mm = 상판 아랫면(z -0.035) ~ 바닥 윗면(z -0.45). 네 개, 다리 바깥 면이 상판 외곽
    #   (x -0.18~1.02, y +-0.30)에서 50mm 안쪽 -> 중심 x -0.115 / 0.955, y +-0.235. 실기 테이블 다리 자료는 없다.
    #   콜라이더 없음 — physics_layer.usd 에 over 를 달지 않는다 (낙하 과실 물리는 런 14 검증 그대로). cuRobo world 에도 없다.
    #   바닥 높이(floor)를 바꾸면 여기 scale z 와 translate z 도 같이 바꾼다 (길이 = -0.035 - 바닥 윗면, 중심 = 둘의 중점).
    def Xform "table_legs"
    {
        def Cube "leg_back_left"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.40, 0.40, 0.40)]
            double3 xformOp:scale = (0.03, 0.03, 0.415)
            double3 xformOp:translate = (-0.115, 0.235, -0.2425)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "leg_back_right"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.40, 0.40, 0.40)]
            double3 xformOp:scale = (0.03, 0.03, 0.415)
            double3 xformOp:translate = (-0.115, -0.235, -0.2425)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "leg_front_left"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.40, 0.40, 0.40)]
            double3 xformOp:scale = (0.03, 0.03, 0.415)
            double3 xformOp:translate = (0.955, 0.235, -0.2425)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "leg_front_right"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.40, 0.40, 0.40)]
            double3 xformOp:scale = (0.03, 0.03, 0.415)
            double3 xformOp:translate = (0.955, -0.235, -0.2425)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
