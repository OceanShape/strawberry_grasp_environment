#usda 1.0
(
    "최상위 씬 — 조립만 담당. 지오메트리를 직접 만들지 말 것. 배치는 layers/layout_layer.usd, 물리는 layers/physics_layer.usd, 조명은 layers/lighting_layer.usd에서 수정"
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./layers/layout_layer.usd@,
        @./layers/physics_layer.usd@,
        @./layers/lighting_layer.usd@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "lab_environment" (
        prepend payload = @./lab_environment.usd@
    )
    {
    }

    def "robot_assembly" (
        prepend references = @../assets/robot/robot_assembly.usd@
    )
    {
    }

    # [2026-09-10] 셀 경계 마커(cell_markers.usd, 분면 꼭지점 봉 9개)는 제거했다.
    #   시야를 가려서. 영역 표시는 assets/props/whiteboard.usd 의 highlight 오버레이
    #   (분면별 옅은 주황 판)가 대신한다 — isaac_sim_hud.py 가 켜고 끈다.

    # [2026-09-07] 딸기 12개 — 익은 6 / 안 익은 6. 보드 4등분 서브셀에 배치.
    #   서브셀 판정은 scan_executor가 "탐지된" 딸기들의 bbox 중점으로 계산하므로,
    #   익은 6개의 bbox 중점이 보드 중심(x=0.050, z=0.660)과 일치하도록 배치했다.
    #   → planner를 수정하지 않고도 상대 분할 결과가 보드 격자와 같아진다.
    #   배치는 layers/layout_layer.usd, 줄기 조인트는 layers/physics_layer.usd.

    def "strawberry_ripe_01" (          # ripe / 보드 nw
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_02" (          # ripe / 보드 nw
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_03" (          # ripe / 보드 ne
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_04" (          # ripe / 보드 sw
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_05" (          # ripe / 보드 sw
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_06" (          # ripe / 보드 sw
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_ripe_07" (          # ripe / 보드 nw — 2026-09-11 unripe_01 을 익은 것으로 전환 (위치 불변, 사용자 결정 8/4)
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_unripe_02" (          # unripe / 보드 ne
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "unripe"
        }
    )
    {
    }

    def "strawberry_ripe_08" (          # ripe / 보드 ne — 2026-09-11 unripe_03 을 익은 것으로 전환 (위치 불변, 사용자 결정 8/4)
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "ripe"
        }
    )
    {
    }

    def "strawberry_unripe_04" (          # unripe / 보드 se
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "unripe"
        }
    )
    {
    }

    def "strawberry_unripe_05" (          # unripe / 보드 se
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "unripe"
        }
    )
    {
    }

    def "strawberry_unripe_06" (          # unripe / 보드 se
        prepend references = @../assets/strawberry/strawberry.usd@
        variants = {
            string ripeness = "unripe"
        }
    )
    {
    }

    # [T3 2026-09-10] 정적 덩굴 12개 — 보드에서 각 딸기 줄기 끝까지.
    #   딸기가 보드 앞 27.2mm 허공에 떠 있던 화면을 고치는 **시각 작업**이다.
    #   T2 로 과실이 그리퍼를 따라 움직이게 되면서, 붙잡고 있던 것이 화면에 없다는 점이
    #   그대로 드러났다. 덩굴이 있으면 "덩굴 끝에서 과실이 떨어져 나가는" 것으로 읽힌다.
    #
    #   프로토타입 1개(assets/props/vine.usd)를 12번 참조한다 — 딸기 12개가 모두
    #   같은 y(0.7828), 같은 orient(항등), 같은 scale 이라 덩굴 형상이 전부 동일하다.
    #   배치는 layers/layout_layer.usd (딸기와 **같은 translate 값**을 쓴다).
    #
    #   ⚠️ 스케일을 주지 않는다. vine.usd 는 이미 월드 치수로 만들어져 있다
    #      (딸기의 scale 0.5 는 애셋 원본이 100배라서 붙은 값이고, 덩굴에는 해당 없음).
    #   물리 없음 — physics_layer.usd 는 이 프림을 건드리지 않는다. 이름에
    #   "strawberry" 가 없어 브릿지의 좌표 발행 필터에도 걸리지 않는다.
    def Scope "vines"
    {
        def "vine_ripe_01" (          # ripe / 보드 nw
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_02" (          # ripe / 보드 nw
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_03" (          # ripe / 보드 ne
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_04" (          # ripe / 보드 sw
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_05" (          # ripe / 보드 sw
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_06" (          # ripe / 보드 sw
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_07" (          # ripe / 보드 nw (종전 vine_unripe_01)
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_unripe_02" (          # unripe / 보드 ne
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_ripe_08" (          # ripe / 보드 ne (종전 vine_unripe_03)
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_unripe_04" (          # unripe / 보드 se
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_unripe_05" (          # unripe / 보드 se
            prepend references = @../assets/props/vine.usd@
        )
        {
        }

        def "vine_unripe_06" (          # unripe / 보드 se
            prepend references = @../assets/props/vine.usd@
        )
        {
        }
    }

    # [T4-3 2026-09-11] 계란판 시각 메쉬. 수평·직사각·컵 15개 동일 (피치만 플래너 티칭 상수의 크기).
    #   격자 왜곡(84.26°)은 티칭 오차라 판에 굽지 않는다 — 과실이 컵에서 벗어나는 모습으로 보인다.
    #   3차(09-11): 실기 15구 계란판처럼 컵을 깊게(림 z57). 4차(09-11): 격자를 시뮬 전용 정사각 68mm 로, 컵 안쪽은 과실 프로파일을
    #   따르고 바닥은 과실 밑끝에, 밑변은 테이블 상판에 — 인접 칸(0,1,3,4,6,7) 배치. 피치는 배치 격자 파라미터와 쌍(verify 대조).
    #   물리·콜라이더 없음, 이름에 "strawberry" 없음. 배치(translate+yaw fit)는 layers/layout_layer.usd,
    #   생성기·검증기는 scripts/scene_tools/.
    def "egg_carton" (
        prepend references = @../assets/props/egg_carton.usd@
    )
    {
    }
}
