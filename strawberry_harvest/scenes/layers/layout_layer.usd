#usda 1.0
(
    "배치(transform) 오버라이드 레이어 — 딸기 위치, 로봇 베이스, 초기 관절 포즈 등 반복 실험에서 바뀌는 값을 이 레이어에 모음. domain randomization 스크립트도 이 레이어를 대상으로 작성"
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "robot_assembly"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "joints"
        {
            over "joint_1"
            {
                float drive:angular:physics:targetPosition = 87.98
                float state:angular:physics:position = 87.98
            }

            over "joint_2"
            {
                float drive:angular:physics:targetPosition = -94.92
                float state:angular:physics:position = -94.92
            }

            over "joint_3"
            {
                float drive:angular:physics:targetPosition = 129.89
                float state:angular:physics:position = 129.89
            }

            over "joint_4"
            {
                float drive:angular:physics:targetPosition = 175.94
                float state:angular:physics:position = 175.94
            }

            over "joint_5"
            {
                float drive:angular:physics:targetPosition = -31.34
                float state:angular:physics:position = -31.34
            }

            over "joint_6"
            {
                float drive:angular:physics:targetPosition = 93.42
                float state:angular:physics:position = 93.42
            }

            # [Stage1 2026-09-07] 그리퍼 초기 개도를 플래너의 접근 개도에 맞춘다.
            #
            # 종전 63도/57.3도 는 URDF 한계(1.101rad=63.08도)에 붙은 **거의 완전 닫힘**이었다.
            # 브릿지가 6축 팔 관절만 발행하고 Isaac 스크립트가 나머지 DOF를 현재값으로
            # 채우는 구조라, 시뮬 그리퍼는 처음부터 끝까지 이 상태로 고정돼 있었다.
            # 그 결과 cuRobo 는 완전열림(팁 플랜지+233.3mm)으로 계획하는데 실제는
            # 닫힘(팁 +262.0mm)이라 27.5mm 차이가 그대로 보드 관통으로 나타났다.
            #
            # 변경: 네 관절 모두 stroke 600 = 600/700 rad = 53.05도.
            #   600 = harvest_motion_params.GRIPPER_APPROACH_POS (플래너가 수평 진입 전에
            #   set_position(600)으로 명령하는 값).
            #   [2026-09-08 rev2] 변환식은 stroke/700 x 1.0 이다.
            #   robot.urdf 의 rh_r2/rh_l2 상한이 1.0 rad 이라 평행사변형 유지 상한이 1.0 이다.
            #   1.101 로 올리면 l2/r2 만 잘려 손가락이 기울고 "가위" 모양이 된다.
            # 이제 sim_executor_bridge_node 가 그리퍼 관절도 발행하므로 이 값은
            # "브릿지가 첫 명령을 보내기 전까지의 초기 자세"다.
            over "rh_l1"
            {
                float drive:angular:physics:targetPosition = 53.05
                float state:angular:physics:position = 53.05
            }

            over "rh_l2"
            {
                float drive:angular:physics:targetPosition = 53.05
                float state:angular:physics:position = 53.05
            }

            over "rh_p12_rn"
            {
                float drive:angular:physics:targetPosition = 53.05
                float state:angular:physics:position = 53.05
            }

            over "rh_r2"
            {
                float drive:angular:physics:targetPosition = 53.05
                float state:angular:physics:position = 53.05
            }
        }
    }

    # [M2-fix 2026-09-07] 보드를 플래너 벽 모델(WALL_SURFACE_Y_M = 0.672)에 실제로 정합.
    #
    # 2026-09-05 캘리브레이션은 전제 두 가지가 틀려서 오차가 남아 있었다:
    #   (1) "반두께 28.5mm" — assets/props/whiteboard.usd 의 board 는 점 4개·면 1개짜리
    #       두께 0 평면이다. 뺄 반두께가 없으므로 보드 면은 translate.y 자리에 그대로 있다.
    #       → translate.y=0.7005 는 앞면 672.0mm 가 아니라 평면 자체를 700.5mm 에 놓았다.
    #   (2) 3° 기울기 무시 — lab_environment.usd 의 orient 법선이 (0.0523, 0.9986, 0) 이라
    #       보드 y 가 x 에 따라 변했다:  y = 700.5 − 52.4·(x − 50) [mm]
    #       실측 범위 672.0mm(우단 x=+594) ~ 729.0mm(좌단 x=−494).
    #       672mm 가 맞는 곳은 오른쪽 끝 모서리 한 점뿐이었고, 익은 딸기 위치에서
    #       플래너 벽 모델 대비 +12.8 ~ +44.2mm 오차가 남아 있었다.
    #
    # 수정: orient 를 기울기 없는 Rx(−90°) 로 교체하고 translate.y 를 0.672 로 둔다.
    #   orient (0.70710678, −0.70710678, 0, 0) → 법선 정확히 world +Y, 보드 로컬 X→world X.
    #   두께 0 이므로 보드 평면 y = translate.y = 672.0mm 가 x 전 구간에서 성립한다.
    # 결과: 보드 x∈[−495, +595] / z∈[265, 1055], y 균일 (기울기 제거는 유지).
    #
    # ★ [2026-09-09] y 를 **810.0mm 로 되돌린다.**
    # 2026-09-05 M2 가 672mm 로 109.5mm 당겼는데, 그 1차 출처를 이번에 찾았다:
    #   strawberry_harvest/scenes/lab_environment.usd (커밋 df0165f, 2026-07-06)
    #     translate = (0.05, 0.81, 0.66)   <- 사용자가 실측으로 설치한 값
    #   같은 커밋의 딸기도 거기 붙어 있었다 (ripe y=803.7 / unripe y=786.4mm).
    # 보드는 두께 0 평면이라 translate.y 가 곧 표면이다 — 앞면 810.0mm.
    # (PLANNER_CHANGES.md 가 한때 '앞면 781.5mm' 라 적은 것은 반두께 28.5mm 를
    #  가정한 옛 오독이다. 뺄 반두께가 없다.)
    #
    # 672mm 에서는 v12 티칭 스캔 자세의 팁-보드 거리가 97~156mm 라 nw/sw 가
    # 실기 영상(최소 15cm)보다 가까웠고, 스캔 자세에서 그리퍼가 과실에 닿았다.
    # 810mm 에서는 207~266mm 가 된다.
    # 딸기 12개도 함께 +138.0mm: y 0.6448 -> 0.7828 (과실 뒷면~보드 5.0mm 유지).
    # 함께 바꿔야 하는 것: physics_layer.usd localPos0, harvest_motion_params.py
    #   WALL_SURFACE_Y_M(0.810), config/environment.yaml x2, scan_collision_world.yaml.
    # 도달성 재검증: 익은 딸기 6/6 IK 성공, 관절 한계 전부 여유 (2026-09-09).
    over "lab_environment"
    {
        over "whiteboard"
        {
            quatd xformOp:orient = (0.7071067811865476, -0.7071067811865476, 0, 0)
            double3 xformOp:translate = (0.05, 0.81, 0.66)
        }

        # [2026-09-09] 보이지 않는 확장 콜라이더.
        #
        # whiteboard/board 는 두께 0 평면이고 크기도 종이판(1100x800) 기준이라,
        # 로봇이 **보드 밑을 훑고 지나가거나 옆으로 돌아가는** 것을 아무것도 막지 않았다.
        # 실기 기록(민2)의 물리 화이트보드는 1500x900mm 이고 스탠드 위에 서 있다.
        # 그 실물 부피 + 바닥까지의 하부를 정지 콜라이더로 세운다. 보이는 보드는
        # 그대로 두고 이것만 invisible 로 추가하므로 렌더링은 바뀌지 않는다.
        #
        #   x [-700, +800]mm   y [672, 872]mm   z [0, 1110]mm
        #   앞면 y=672.0mm 는 종전과 동일 — 파지 기하는 전혀 건드리지 않는다.
        #
        # cuRobo 쪽 같은 상자: config/environment.yaml, config/scan_collision_world.yaml
        # 검증: 티칭 스캔 자세 4개 / 순회 5구간 / 트레이 배치 자세 전부 여유 불변
        #       (트레이만 332.8 -> 327.9mm).
        def Cube "board_guard" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 2
            float3[] extent = [(-1, -1, -1), (1, 1, 1)]
            token visibility = "invisible"
            double3 xformOp:translate = (0.05, 0.91, 0.555)
            double3 xformOp:scale = (0.75, 0.10, 0.555)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }















    # [2026-09-08] ripe_01 (−250,880)→(−250,740), ripe_03 (350,800)→(200,740) 이동.
    #   둘 다 작업영역 가장자리라 pre-approach IK 가 전부 실패해 수확이 안 됐다
    #   (실측: ripe_01 IK_FAIL×7, ripe_03 IK_FAIL×5 + spline_jump reject×4).
    #   cuRobo IK 로 재검증: 새 위치에서 6개 모두 4/4 접근 변형 도달, 최소 간격 67mm.
    #   서브셀도 유지된다 (nw: 01·02 / ne: 03 / sw: 04·05·06).
    #   ⚠️ 서브셀 격자는 2026-09-08 부터 보드 고정이라, 딸기 bbox 중점을 보드 중심에
    #      맞춰야 하던 종전 제약은 없다.
    # [2026-09-07] 딸기 12개 — 보드 4등분 서브셀 배치 (경계: x=0.050, z=0.660)
    #   y=0.7828 고정: 보드 앞면(672.0mm)에서 반지름 22.2 + 여유 5.0 만큼 돌출.
    # ⚠️ 좌표 변경 시 physics_layer.usd 의 stem joint localPos0 도 반드시 함께 수정.

    over "strawberry_ripe_01"   # ripe / 보드 nw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.25, 0.7828, 0.74)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_ripe_02"   # ripe / 보드 nw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.12, 0.7828, 0.76)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_ripe_03"   # ripe / 보드 ne
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.2, 0.7828, 0.74)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_ripe_04"   # ripe / 보드 sw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.22, 0.7828, 0.56)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_ripe_05"   # ripe / 보드 sw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.1, 0.7828, 0.44)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_ripe_06"   # ripe / 보드 sw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.25, 0.7828, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_01"   # unripe / 보드 nw
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (-0.38, 0.7828, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_02"   # unripe / 보드 ne
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.15, 0.7828, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_03"   # unripe / 보드 ne
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.28, 0.7828, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_04"   # unripe / 보드 se
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.12, 0.7828, 0.56)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_05"   # unripe / 보드 se
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.25, 0.7828, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "strawberry_unripe_06"   # unripe / 보드 se
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0.18, 0.7828, 0.38)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

}
