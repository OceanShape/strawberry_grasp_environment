#usda 1.0
(
    "광원 레이어 — 씬의 모든 조명을 이 레이어에서 관리 (시각 전용, 플래너 입출력 불변)"
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    def Xform "lights"
    {
        def DomeLight "dome_light" (
            "무방향 채움광. studio.hdr 텍스처는 밝은 점 방향으로 그림자를 만들어 뺐다(파일은 textures/ 에 남김). 그림자 바닥이 너무 검으면 intensity 를 올린다. [09-16] 카메라가 보는 배경색은 이 돔이 아니다 — 돔은 색과 채움 세기가 같은 값이라 배경만 못 낮춘다. 배경은 Kit 확장 strawberry.sim.setup 이 /rtx/background/source/* 로 차콜 단색을 깔고, 돔은 조명만 맡는다"
        )
        {
            color3f inputs:color = (1, 1, 1)
            float inputs:intensity = 300
        }

        def RectLight "key_top" (
            "주광 — 로봇 베이스(원점)와 보드(y 0.81) 사이 위 1.9 m 에서 아래로, 보드 쪽으로 20° 기울임. 1.2×0.8 m 면광원이라 그림자 가장자리가 부드럽다. 밝기는 exposure 로 ±1 씩 조절"
        )
        {
            color3f inputs:color = (1, 0.98, 0.95)
            float inputs:width = 1.2
            float inputs:height = 0.8
            bool inputs:normalize = 1
            float inputs:intensity = 10000
            float inputs:exposure = 0
            double3 xformOp:translate = (0.1, 0.4, 1.9)
            double3 xformOp:rotateXYZ = (20, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }
}
