#usda 1.0
(
    "딸기 애셋 인터페이스 — 지오메트리(variant) + 물리(sublayer) 조립. 씬에서는 이 파일만 참조할 것"
    defaultPrim = "strawberry"
    metersPerUnit = 1
    subLayers = [
        @./strawberry_physics.usd@
    ]
    upAxis = "Z"
)

def Xform "strawberry" (
    variants = {
        string ripeness = "ripe"
    }
    prepend variantSets = ["ripeness"]
)
{
    variantSet "ripeness" = {
        "ripe" (
            prepend references = @./strawberry_ripe.usd@
        ) {
        }
        "unripe" (
            prepend references = @./strawberry_unripe.usd@
        ) {
        }
    }
}
